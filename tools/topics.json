{
 "schema": "osap-topics/1",
 "note": "Data sets: saved keyword filters over the one news pool. Adding a data set is an entry here, no new code. Every refresh, tools/refresh_topics.mjs runs each entry's searches (Bing News RSS, read only where robots.txt allows; aggregator results, nc) and adds the results to the pool; tools/news_index.mjs then tags every pooled headline (national outlets from tools/news_feeds.json, their history and these searches) with each data set whose words it contains, and writes data/live/news-index.js for the app's news search. Fields: id (a-z0-9-), name (shown in the app), words (any one of them ties a headline to the data set; matched case-insensitively at the start of a word, so 'flood' also matches 'floods' and 'flooding'; any language), exclude (optional words that rule a headline out), countries (optional page ids; empty = every country), searches (optional Bing News queries run each refresh to pull more reporting for this data set; at most 4, default none). A search result is a news search hit, not a verified report.",
 "topics": [
  {"id": "earthquakes", "name": "Earthquakes and tsunamis", "words": ["earthquake", "quake", "tremor", "aftershock", "tsunami", "seismic"], "exclude": ["earthquake drill"], "searches": ["earthquake", "tsunami warning"]},
  {"id": "storms", "name": "Typhoons, cyclones and hurricanes", "words": ["typhoon", "cyclone", "hurricane", "tropical storm", "tropical depression", "super typhoon"], "searches": ["typhoon", "cyclone", "hurricane"]},
  {"id": "floods", "name": "Floods and landslides", "words": ["flood", "flash flood", "landslide", "mudslide", "inundat", "monsoon rain", "dam burst"], "searches": ["flooding", "landslide"]},
  {"id": "wildfires", "name": "Wildfires", "words": ["wildfire", "bushfire", "forest fire", "haze"], "searches": ["wildfire"]},
  {"id": "outbreaks", "name": "Disease outbreaks", "words": ["outbreak", "epidemic", "pandemic", "cholera", "dengue", "mpox", "measles", "bird flu", "avian influenza", "ebola", "marburg", "anthrax"], "searches": ["disease outbreak", "cholera outbreak"]},
  {"id": "attacks", "name": "Bombings and attacks", "words": ["bomb", "bombing", "IED", "explosion", "suicide attack", "gunmen", "terror attack", "terrorist", "militants", "ambush", "insurgent"], "exclude": ["bombshell", "photobomb"], "searches": ["bomb attack", "terror attack"]},
  {"id": "unrest", "name": "Protests and unrest", "words": ["protest", "protester", "riot", "demonstrator", "curfew", "unrest", "tear gas", "general strike"], "searches": ["protesters police", "curfew imposed"]},
  {"id": "elections", "name": "Elections and coups", "words": ["election", "referendum", "ballot", "polling station", "coup", "junta", "martial law"], "searches": ["election results", "coup attempt"]},
  {"id": "south-china-sea", "name": "South China Sea", "words": ["South China Sea", "West Philippine Sea", "Scarborough", "Spratly", "Paracel", "Second Thomas Shoal", "Ayungin", "Sabina Shoal", "China Coast Guard", "Nine-dash"], "searches": ["South China Sea"]},
  {"id": "shipping", "name": "Shipping and piracy", "words": ["piracy", "pirates", "hijacked ship", "tanker", "cargo ship", "vessel seized", "shipwreck", "ferry capsized", "capsized", "Red Sea shipping", "Strait of Hormuz", "Malacca Strait"], "searches": ["piracy ship", "vessel seized"]},
  {"id": "air-crashes", "name": "Air crashes and incidents", "words": ["plane crash", "air crash", "helicopter crash", "emergency landing", "airliner", "aircraft crashed", "jet crashed"], "searches": ["plane crash"]},
  {"id": "cyber", "name": "Cyber attacks", "words": ["cyberattack", "cyber attack", "ransomware", "data breach", "hackers", "DDoS", "hacked"], "searches": ["cyberattack", "ransomware"]}
