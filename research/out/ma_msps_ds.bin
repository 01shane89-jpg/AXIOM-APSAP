te": "active", "vocabulary_id": null}, {"display_name": "m\u00e9dicament", "id": "5885ad91-a310-472b-9f04-926f89b9de4a", "name": "m\u00e9dicament", "state": "active", "vocabulary_id": null}, {"display_name": "princeps", "id": "2125518b-6a26-4ab7-ac15-5f4bae5bb1cf", "name": "princeps", "state": "active", "vocabulary_id": null}, {"display_name": "prix public de vente", "id": "13adce4e-724f-492e-9ebb-e9543e1f691f", "name": "prix public de vente", "state": "active", "vocabulary_id": null}, {"display_name": "remboursement", "id": "3ae6f242-6589-46f1-974e-e16c596928c8", "name": "remboursement", "state": "active", "vocabulary_id": null}], "relationships_as_subject": [], "relationships_as_object": [], "title_translated": {"fr": "Dispositifs m\u00e9dicaux admis au rembourssement", "ar": "\u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0637\u0628\u064a\u0629 \u0627\u0644\u0645\u064f\u0639\u0648\u0636 \u0639\u0646\u0647\u0627"}, "notes_translated": {"fr": "Ces dispositifs repr\u00e9sentent la liste des dispositifs m\u00e9dicaux devant \u00eatre admis au remboursement par le CNOPS et donnant lieu \u00e0 demande d\u2019entente pr\u00e9alables.\r\n", "ar": "\u062a\u0645\u062b\u0644 \u0647\u0630\u0647 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0637\u0628\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0645 \u062a\u0639\u0648\u064a\u0636\u0647\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0645\u0646\u0638\u0645\u0627\u062a \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0645\u0639 \u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 \u0645\u0633\u0628\u0642."}}, {"author": "", "author_email": "", "creator_user_id": "02391106-2ff8-4f01-81e1-8dc81ac06205", "id": "0b957639-4a47-4db7-abf9-8cb7a0ce603b", "isopen": true, "license_id": "odc-odbl", "license_title": "Open Data Commons Open Database License (ODbL)", "license_url": "http://www.opendefinition.org/licenses/odc-odbl", "maintainer": "", "maintainer_email": "", "metadata_created": "2014-05-15T13:05:28.385542", "metadata_modified": "2021-12-11T10:54:43.959142", "name": "donnees-sur-l-offre-de-soins-privees", "notes": "Sont pr\u00e9sent\u00e9es dans ce ficher les donn\u00e9es sur l'offre de soins priv\u00e9es. On y trouve \u00e9galement d'autres structures consid\u00e9r\u00e9es comme publiques mais qui ne sont pas sous le contr\u00f4le du MS. Il s'agit par exemple des h\u00f4pitaux militaires, la ligue nationale des maladies cardiovasculaires et la fondation de neuroscience.", "notes_ar": "\u064a\u0642\u062f\u0645 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 \u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0646 \u0639\u0631\u0648\u0636 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629. \u0643\u0645\u0627 \u0646\u062c\u062f \u0623\u064a\u0636\u064b\u0627 \u0645\u0646\u0634\u0622\u062a \u0623\u062e\u0631\u0649 \u062a\u0639\u062a\u0628\u0631 \u0639\u0645\u0648\u0645\u064a\u0629 \u0648\u0644\u0643\u0646\u0647\u0627 \u0644\u0627 \u062a\u062e\u0636\u0639 \u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062d\u0629. \u0648\u062a\u0634\u0645\u0644 \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u064a\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0648\u0627\u0644\u0631\u0627\u0628\u0637\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0642\u0644\u0628 \u0648\u0627\u0644\u0623\u0648\u0639\u064a\u0629 \u0627\u0644\u062f\u0645\u0648\u064a\u0629 \u0648\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0639\u0635\u0628\u064a\u0629.", "notes_fr": "Sont pr\u00e9sent\u00e9es dans ce ficher les donn\u00e9es sur l'offre de soins priv\u00e9es. On y trouve \u00e9galement d'autres structures consid\u00e9r\u00e9es comme publiques mais qui ne sont pas sous le contr\u00f4le du MS. Il s'agit par exemple des h\u00f4pitaux militaires, la ligue nationale des maladies cardiovasculaires et la fondation de neuroscience.", "num_resources": 1, "num_tags": 1, "organization": {"id": "746b08ba-ed7e-462c-b85a-705ebfed24d1", "name": "ministere-de-la-sante", "title": "Minist\u00e8re de la Sant\u00e9 et de la Protection Sociale", "type": "organization", "description": "Donn\u00e9es ouvertes du Minist\u00e8re de la Sant\u00e9 et de la Protection Sociale", "image_url": "2021-11-12-233754.352774Sante.png", "created": "2014-04-24T20:09:45.716882", "is_organization": true, "approval_status": "approved", "state": "active", "title_translated": {"fr": "Minist\u00e8re de la Sant\u00e9 et de la Protection Sociale", "ar": "\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062d\u0629 \u0648\u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629"}, "description_translated": {"fr": "Donn\u00e9es ouvertes du Minist\u00e8re de la Sant\u00e9 et de la Protection Sociale", "ar": "\u0645\u0639\u0637\u064a\u0627\u062a \u0645\u0641\u062a\u0648\u062d\u0629 \u062e\u0627\u0635\u0629 \u0628\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062d\u0629 \u0648\u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629"}}, "owner_org": "746b08ba-ed7e-462c-b85a-705ebfed24d1", "private": false, "state": "active", "title": "Donn\u00e9es sur l'offre de soins priv\u00e9es", "title_ar": "\u0645\u0639\u0637\u064a\u0627\u062a \u0639\u0646 \u0639\u0631\u0648\u0636 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629", "title_fr": "Donn\u00e9es sur l'offre de soins priv\u00e9es", "type": "dataset", "url": "Agence Nationale de l'Assurance Maladie", "version": "", "groups": [{"description": "Donn\u00e9es ouvertes dans le domaine de la sant\u00e9.", "display_name": "Sant\u00e9", "id": "78a87b54-a98d-4eac-9a14-73b88ea76c5a", "image_display_url": "https://data.gov.ma/data/uploads/group/2021-09-26-222737.097653SANTE.png", "name": "sante", "title": "Sant\u00e9"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2017-12-18T20:41:45.643698", "datastore_active": false, "description": "Offre de soins priv\u00e9es 2013", "format": "XLS", "hash": "", "id": "4a400757-4921-411f-a48a-70596e546933", "last_modified": "2017-12-18T20:41:45.627197", "metadata_modified": "2017-12-18T20:41:45.637064", "mimetype": "application/vnd.ms-excel", "mimetype_inner": null, "name": "Offre de soins priv\u00e9es 2013", "package_id": "0b957639-4a47-4db7-abf9-8cb7a0ce603b", "position": 0, "resource_type": null, "size": 28160, "state": "active", "url": "https://data.gov.ma/data/fr/dataset/0b957639-4a47-4db7-abf9-8cb7a0ce603b/resource/4a400757-4921-411f-a48a-70596e546933/download/offre-privees-2013.xls", "url_type": "upload"}], "tags": [{"display_name": "Sant\u00e9", "id": "cb76345d-0af0-4a1b-9ce3-a7293a19801a", "name": "Sant\u00e9", "state": "active", "vocabulary_id": null}], "relationships_as_subject": [], "relationships_as_object": [], "title_translated": {"fr": "Donn\u00e9es sur l'offre de soins priv\u00e9es", "ar": "\u0645\u0639\u0637\u064a\u0627\u062a \u0639\u0646 \u0639\u0631\u0648\u0636 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629"}, "notes_translated": {"fr": "Sont pr\u00e9sent\u00e9es dans ce ficher les donn\u00e9es sur l'offre de soins priv\u00e9es. On y trouve \u00e9galement d'autres structures consid\u00e9r\u00e9es comme publiques mais qui ne sont pas sous le contr\u00f4le du MS. Il s'agit par exemple des h\u00f4pitaux militaires, la ligue nationale des maladies cardiovasculaires et la fondation de neuroscience.", "ar": "\u064a\u0642\u062f\u0645 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 \u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0646 \u0639\u0631\u0648\u0636 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629. \u0643\u0645\u0627 \u0646\u062c\u062f \u0623\u064a\u0636\u064b\u0627 \u0645\u0646\u0634\u0622\u062a \u0623\u062e\u0631\u0649 \u062a\u0639\u062a\u0628\u0631 \u0639\u0645\u0648\u0645\u064a\u0629 \u0648\u0644\u0643\u0646\u0647\u0627 \u0644\u0627 \u062a\u062e\u0636\u0639 \u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062d\u0629. \u0648\u062a\u0634\u0645\u0644 \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u064a\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0648\u0627\u0644\u0631\u0627\u0628\u0637\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0642\u0644\u0628 \u0648\u0627\u0644\u0623\u0648\u0639\u064a\u0629 \u0627\u0644\u062f\u0645\u0648\u064a\u0629 \u0648\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0639\u0635\u0628\u064a\u0629."}}, {"author": "", "author_email": "", "available_languages": "[\"fr\", \"ar\"]", "collection_frequency": "annuel", "creator_user_id": "41d99e66-e547-4850-b70b-e268d6ee37a6", "disaggregation_level": "National", "geographic_coverage": "Nationale", "id": "33eb241e-28a7-4156-bb05-09148308e7ab", "is_active": "actif", "isopen": true, "license_id": "odc-odbl", "license_title": "Open Data Commons Open Database License (ODbL)", "license_url": "https://opendefinition.org/licenses/odc-odbl", "maintainer": "", "maintainer_email": "", "metadata_created": "2023-10-27T15:17:16.494376", "metadata_modified": "2026-03-09T13:51:20.474444", "name": "indicateurs-sociaux-2012-2024", "notes": "Ce fichier pr\u00e9sente les indicateurs sociaux pour la p\u00e9riode de 2012 \u00e0 2024 :\r\n-  D\u00e9mographie\r\n- Education et formation\r\n- Emploi et salaires  \r\n- Sant\u00e9 \r\n- Niveau de vie et Equipements de base\r\n", "notes_ar": "\u064a\u0642\u062f\u0645 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0625\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0645\u0646 2012 \u0625\u0644\u0649 2024\r\n\r\n \u0627\u0644\u062f\u064a\u0645\u063a\u0631\u0627\u0641\u064a\u0627-\r\n\r\n \u0627\u0644\u062a\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u062a\u0643\u0648\u064a\u0646-\r\n\r\n\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0648\u0627\u0644\u0623\u062c\u0648\u0631-\r\n\r\n\u0627\u0644\u0635\u062d\u0629-\r\n\r\n\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0645\u0639\u064a\u0634\u0629  \u0648\u0627\u0644\u062a\u062c\u0647\u064a\u0632\u0627\u062a \u0627\u0644\u0623 \u0633\u0627\u0633\u064a\u0629-\r\n\r\n", "num_resources": 4, "num_tags": 28, "organization": {"id": "b428a1d6-2c1b-409a-a7e6-46272f2cf4c9", "name": "ministere-de-l-economie-et-des-finances", "title": "MEF", "type": "organization", "description": "Donn\u00e9es ouvertes du Minist\u00e8re de l'Economie et des Finances.", "image_url": "2021-11-13-185149.251169MEF.jpg", "created": "2013-09-23T11:33:49.318114", "is_organization": true, "approval_status": "approved", "state": "active", "title_translated": {"fr": "MEF", "ar": "\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0648\u0627\u0644\u0645\u0627\u0644\u064a\u0629"}, "description_translated": {"fr": "Donn\u00e9es ouvertes du Minist\u00e8re de l'Economie et des Finances.", "ar": "\u0645\u0639\u0637\u064a\u0627\u062a \u0645\u0641\u062a\u0648\u062d\u0629 \u062e\u0627\u0635\u0629 \u0628\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0648\u0627\u0644\u0645\u0627\u0644\u064a\u0629"}}, "owner_org": "b428a1d6-2c1b-409a-a7e6-46272f2cf4c9", "private": false, "state": "active", "storage_format": "Excel", "tag_string_ar": "\u0627\u0644\u0633\u0627\u0643\u0646\u0629 \u062d\u0633\u0628 \u0627\u0644\u0648\u0633\u0637 \u0648 \u0627\u0644\u0641\u0626\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u064a\u0629,\u0645\u0639\u062f\u0644 \u0627\u0644\u062a\u0645\u062f\u0631\u0633 \u0627\u0644\u062e\u0627\u0635 \u0628\u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u0623\u0633\u0627\u0633\u064a,\u0639\u062f\u062f \u0627\u0644\u062a\u0644\u0627\u0645\u064a\u0630 \u0648\u0627\u0644\u0637\u0644\u0628\u0629,\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u062a\u062f\u0631\u0628\u064a\u0646 \u062d\u0633\u0628 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u0643\u0648\u064a\u0646 \u0627\u0644\u0645\u0647\u0646\u064a,\u0645\u0639\u062f\u0644 \u0627\u0644\u0623\u0645\u064a\u0629,\u0639\u062f\u062f \u0627\u0644\u0633\u0643\u0627\u0646 \u0627\u0644\u0646\u0634\u064a\u0637\u064a\u0646,\u0645\u0639\u062f\u0644 \u0627\u0644\u0646\u0634\u0627\u0637,\u0639\u062f\u062f \u0627\u0644\u0633\u0643\u0627\u0646 \u0627\u0644\u0646\u0634\u064a\u0637\u064a\u0646 \u0627\u0644\u0645\u0634\u062a\u063a\u0644\u064a\u0646,\u0639\u062f\u062f \u0627\u0644\u0633\u0643\u0627\u0646 \u0627\u0644\u0646\u0634\u064a\u0637\u064a\u0646 \u0627\u0644\u0639\u0627\u0637\u0644\u064a\u0646,\u0645\u0639\u062f\u0644 \u0627\u0644\u0628\u0637\u0627\u0644\u0629,\u0639\u062f\u062f \u0627\u0644\u0633\u0643\u0627\u0646 \u0644\u0643\u0644 \u0637\u0628\u064a\u0628,\u0623\u0645\u0644 \u0627\u0644\u062d\u064a\u0627\u0629 \u0639\u0646\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629,\u0645\u0639\u062f\u0644 \u0627\u0644\u0641\u0642\u0631,\u0646\u0633\u0628\u0629 \u0643\u0647\u0631\u0628\u0629 \u0627\u0644\u0642\u0631\u0649", "temporal_coverage_end": "2024-12-31", "temporal_coverage_start": "2013-01-01", "title": "Indicateurs sociaux", "title_ar": " \u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0625\u062c\u062a\u0645\u0627\u0639\u064a\u0629 ", "type": "dataset", "url": "", "version": "", "groups": [{"description": "Donn\u00e9es ouvertes dans le domaine de l'\u00e