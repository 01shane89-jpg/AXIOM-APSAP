{
  "name": "osap-desktop",
  "productName": "AXIOM OSAP",
  "version": "0.0.0-dev",
  "description": "AXIOM OSAP desktop program: the Open Source Awareness Platform in its own window.",
  "author": "AXIOM OSAP",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "io.github.osap.desktop",
    "productName": "AXIOM OSAP",
    "artifactName": "AXIOM-OSAP-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "AXIOM OSAP"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.reference",
      "identity": "-"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "AXIOM OSAP",
      "executableName": "axiom-osap"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/01shane89-jpg/AXIOM-APSAP.git"
  }
}
